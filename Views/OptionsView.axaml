<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Etiquetadora.ViewModels"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="350"
        Width="300" Height="350" CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        x:DataType="vm:OptionsViewModel"
        x:Class="Etiquetadora.Views.OptionsView"
        Title="Options">
    
    <Design.DataContext>
        <vm:OptionsViewModel />
    </Design.DataContext>
    
    <Grid>
        <Border Padding="10" Background="{DynamicResource PrimaryBackground}">
            <StackPanel Spacing="12">
                <TextBlock Text="Opciones de Generador" HorizontalAlignment="Center"></TextBlock>
                
                <StackPanel>
                    <TextBlock Text="Opciones de etiqueta:"></TextBlock>
                    <TextBox PlaceholderText="Ancho etiqueta (en mm)" Text="{Binding TagWidthOption}"></TextBox>
                    <TextBox PlaceholderText="Alto etiqueta (en mm)" Text="{Binding TagHeightOption}"></TextBox>
                </StackPanel>
                
                <StackPanel>
                    <TextBlock Text="Opciones de código de barras:"></TextBlock>
                    <TextBox PlaceholderText="Margen lateral (en mm)" Text="{Binding SideMarginOption}"></TextBox>
                    <TextBox PlaceholderText="Margen inferior (en mm)" Text="{Binding BottomMarginOption}"></TextBox>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
