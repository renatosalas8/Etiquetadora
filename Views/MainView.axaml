<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Etiquetadora.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:Etiquetadora.Models"
        xmlns:viewModels="clr-namespace:Etiquetadora.ViewModels"
        xmlns:services="clr-namespace:Etiquetadora.Services"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        Width="800" Height="600" CanResize="False"
        x:Class="Etiquetadora.Views.MainView"
        x:DataType="viewModels:MainViewModel"
        Background="{DynamicResource MainBackground}"
        Icon="/Assets/logo.ico"
        Title="Etiquetadora">
    
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    
    <Window.Styles>
        <Style Selector="TextBox.InvalidPrice /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#D0FF0000"/>
        </Style>
    </Window.Styles>
    
    <Grid ColumnDefinitions="350,*" Margin="20">
        <Border Grid.Column="0" Padding="30" Background="{DynamicResource PrimaryBackground}" 
                CornerRadius="10">
            <Grid RowDefinitions="Auto, Auto, *" RowSpacing="20" >
                <StackPanel Grid.Row="0" VerticalAlignment="Top" Spacing="24">
                    <TextBlock Text="Generadora de Etiquetas" FontSize="22"/>
                    <TextBox Text="{Binding ProductName}" 
                             PlaceholderText="Nombre del producto"
                             Background="{DynamicResource TextControlBackground}"/>
                    <TextBox Text="{Binding ProductPrice, Mode=TwoWay}" 
                             PlaceholderText="Precio"
                             Classes.InvalidPrice="{Binding IsPriceInvalid}"/>

                    <Grid RowDefinitions="28,*" Margin="0,-8,0,0">
                        <CheckBox Grid.Row="0" 
                                  Name="SKUCheckbox" 
                                  Content="Autogenerar SKU?"
                                  IsEnabled="True"/>
                        <TextBox Grid.Row="1" 
                                 IsEnabled="{Binding !#SKUCheckbox.IsChecked}" 
                                 Text="{Binding ProductSku}" 
                                 PlaceholderText="SKU (máximo 12 números)" 
                                 MaxLength="12"/>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="Plantilla:" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <ComboBox x:Name="PresetsComboBox"
                                      ItemsSource="{Binding Presets}" 
                                      SelectedItem="{Binding CurrentPreset, Mode=TwoWay}"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="services:PresetAttributes">
                                        <Grid ColumnDefinitions="Auto,Auto, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                    
                            <Button VerticalAlignment="Center" Command="{Binding ShowPresetsWindowCommand}"
                                    Width="32" Height="32">
                                <PathIcon Data="{DynamicResource text_bullet_list_square_regular}"
                                          Width="16" Height="16"/>
                            </Button>
                            
                            <Button VerticalAlignment="Center" Command="{Binding EditPresetWindowCommand}"
                                    Width="32" Height="32">
                                <PathIcon Data="{DynamicResource edit_settings_regular}"
                                          Width="16" Height="16"/>
                            </Button>
                    
                            <Button VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Command="{Binding NewPresetWindowCommand}"
                                    Width="32" Height="32">
                                <PathIcon Data="{DynamicResource add_square_regular}"
                                          Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Button  Grid.Row="2" Content="Borrar datos" HorizontalContentAlignment="Center" HorizontalAlignment="Left" 
                        VerticalAlignment="Bottom"
                        Width="100" Command="{Binding NewLabelCommand}" 
                        IsVisible="{Binding CanDeleteInputs}"/>
            </Grid>
        </Border>
        
        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Margin="20,0,0,0">
            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="{Binding PresetInfo}"
                           HorizontalAlignment="Center"
                           Foreground="White"/>
        
                <Image Grid.Row="1" Source="{Binding BarcodeSvg}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Stretch="Uniform"
                />
            </Grid>
            
            <Button Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0" 
                    Content="Guardar etiqueta" Command="{Binding SaveFileCommand}"
                    IsEnabled="{Binding CanSaveTag}"/>
        </Grid>
    </Grid>
</Window>
